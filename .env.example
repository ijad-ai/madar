# Copy to .env for local development. Never commit .env.
# Values here are local-only defaults that match docker-compose.yml.

NODE_ENV=development
SERVICE_NAME=madar
LOG_LEVEL=info

# Redis (BullMQ queue). Production must use rediss:// (TLS).
REDIS_URL=redis://127.0.0.1:6379

# Postgres (audit log, session metadata). Production must set sslmode=require or stricter.
# The password below is the local docker-compose default, not a real secret.
DATABASE_URL=postgres://madar:madar_local_dev@127.0.0.1:5432/madar
