# Copy to .env for local development. Never commit .env.
# Values here are local-only defaults that match docker-compose.yml.
# Empty values count as unset.

NODE_ENV=development
SERVICE_NAME=madar
LOG_LEVEL=info

# Redis (BullMQ queue, thread locks). Production must use rediss:// (TLS).
REDIS_URL=redis://127.0.0.1:6379
# Namespace for every Redis key. Give each environment sharing a Redis its own.
REDIS_KEY_PREFIX=madar

# Postgres (audit log, run state). Production must set sslmode=require or stricter.
# The password below is the local docker-compose default, not a real secret.
DATABASE_URL=postgres://madar:madar_local_dev@127.0.0.1:5432/madar

# Which Slack channels the bot answers in, per project. See docs/slack-setup.md.
PROJECTS_FILE=config/projects.json

# --- Slack (docs/slack-setup.md) ---
# socket (default, no public endpoint) or http.
SLACK_TRANSPORT=socket
# Bot token, xoxb-…  Needed by the gateway and the worker.
SLACK_BOT_TOKEN=
# App-level token, xapp-…  Needed by the gateway in socket mode.
SLACK_APP_TOKEN=
# Signing secret. Needed by the gateway in http mode.
SLACK_SIGNING_SECRET=
SLACK_HTTP_PORT=3000
# Tests and fakes only. Never set in production.
SLACK_API_URL=

# --- Claude agent ---
# Needed by the worker.
ANTHROPIC_API_KEY=
# Leave empty for the default API endpoint.
ANTHROPIC_BASE_URL=
AGENT_MODEL=claude-sonnet-5-5
# Per-run budgets. A run that hits one stops and says which.
AGENT_MAX_TURNS=8
AGENT_MAX_TOKENS=200000
AGENT_MAX_COST_USD=2
AGENT_TIMEOUT_SECONDS=300
# How many times the agent retries a failed Claude API call. The SDK default is 10.
AGENT_API_MAX_RETRIES=3
# Parent directory for per-run working directories. Empty means the OS temp dir.
AGENT_WORK_DIR=

# --- Queue ---
# Runs per worker process, and an optional limit across all workers.
WORKER_CONCURRENCY=4
GLOBAL_CONCURRENCY=
RATE_LIMIT_PER_USER_PER_HOUR=30
